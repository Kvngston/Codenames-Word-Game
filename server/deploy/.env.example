# Copy to .env on the VM and fill in. .env is gitignored.

# DNS name with an A record pointing at the VM's public IP.
API_DOMAIN=api.example.com

# The Vercel site(s) allowed to call the API. Comma-separated; wildcards allowed,
# e.g. https://word-agents.vercel.app,https://word-agents-*.vercel.app
ALLOWED_ORIGINS=https://word-agents.vercel.app

# Generate each with: openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
RABBITMQ_USERNAME=wordagents
RABBITMQ_PASSWORD=

# Nightly backups (backup-mysql.sh): OCI Object Storage bucket name.
BACKUP_BUCKET=word-agents-backups
BACKUP_KEEP_DAYS=14
